# Copy this file to .env for local `vercel dev`, and set the same
# variables in your Vercel project's dashboard (Settings -> Environment
# Variables) for the deployed site. See README.md for how to get a
# MongoDB Atlas connection string.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=seal_command
